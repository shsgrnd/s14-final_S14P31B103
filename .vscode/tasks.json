{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm compile",
            "type": "shell",
            "command": "pnpm --filter @gitcat/storage run build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; pnpm --filter @gitcat/shared-types run build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; pnpm run compile",
            "options": {
                "cwd": "${workspaceFolder}/apps/extension",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "group": "build",
            "presentation": {
                "panel": "dedicated",
                "reveal": "never"
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "pnpm watch",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "run",
                "watch"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/extension"
            },
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "never"
            },
            "problemMatcher": [
                "$tsc-watch"
            ]
        }
    ]
}