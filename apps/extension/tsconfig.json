{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@gitcat/shared-types": ["../../packages/shared-types/dist"],
      "@gitcat/storage": ["../../packages/storage/dist"],
      "@gitcat/git-core": ["../../packages/git-core/dist"],
      "@gitcat/git-client-cli": ["../../packages/git-client-cli/dist"],
      "@gitcat/ai-pipeline": ["../../packages/ai-pipeline/dist/ai-pipeline/src"]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
