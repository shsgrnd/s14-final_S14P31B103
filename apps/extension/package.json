{
  "name": "gitcat",
  "displayName": "GitCat",
  "description": "An AI-powered Git assistant for safer commits, conflict prevention, and smarter workflow guidance in VS Code.",
  "publisher": "ssafy",
  "icon": "media/GitCat_icon.png",
  "version": "0.0.1",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shsgrnd/s14-final_S14P31B103.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:gitcat-sidebar-webview",
    "onCommand:gitcat.openPanel",
    "onCommand:gitcat.getGitStatus",
    "onCommand:gitcat.installLocalRuntime",
    "onCommand:gitcat.setGitHubToken",
    "onCommand:gitcat.clearGitHubToken"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitcat.openPanel",
        "title": "GitCat: Open Panel"
      },
      {
        "command": "gitcat.getGitStatus",
        "title": "GitCat: Refresh Status"
      },
      {
        "command": "gitcat.installLocalRuntime",
        "title": "GitCat: Install Local Runtime"
      },
      {
        "command": "gitcat.setGitHubToken",
        "title": "GitCat: Set GitHub Token"
      },
      {
        "command": "gitcat.clearGitHubToken",
        "title": "GitCat: Clear GitHub Token"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitcat-sidebar",
          "title": "GitCat",
          "icon": "media/GitCat_icon.png"
        }
      ]
    },
    "views": {
      "gitcat-sidebar": [
        {
          "type": "webview",
          "id": "gitcat-sidebar-webview",
          "name": "GitCat",
          "icon": "media/GitCat_icon.png"
        }
      ]
    },
    "configuration": {
      "title": "GitCat",
      "properties": {
        "gitcat.branchCleanup.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Branch Cleanup 기능 활성화 여부"
        },
        "gitcat.branchCleanup.olderThanValue": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "이 값보다 오래된 브랜치를 정리 후보로 간주합니다."
        },
        "gitcat.branchCleanup.olderThanUnit": {
          "type": "string",
          "enum": ["week", "month"],
          "default": "month",
          "description": "olderThanValue의 시간 단위 (week 또는 month)"
        },
        "gitcat.branchCleanup.deleteMergedBranches": {
          "type": "boolean",
          "default": true,
          "description": "이미 머지된 로컬 브랜치를 삭제 후보에 포함할지 여부"
        },
        "gitcat.branchCleanup.deleteGoneRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "원격 추적 브랜치가 사라진(gone) 로컬 브랜치를 삭제 후보에 포함할지 여부"
        },
        "gitcat.branchCleanup.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["main", "master", "develop", "dev", "release"],
          "description": "절대 삭제하지 않을 보호 브랜치 목록"
        },
        "gitcat.ai.mode": {
          "type": "string",
          "enum": ["live-remote", "live-local", "mock"],
          "default": "live-local",
          "description": "AI 추론 모드를 설정합니다. 'live-local'은 로컬 GGUF 모델을 사용하고, 'live-remote'는 원격 GMS API를 사용합니다."
        },
        "gitcat.ai.localModelPath": {
          "type": "string",
          "default": "",
          "description": "로컬 추론(live-local) 시 사용할 GGUF 모델 파일의 절대 경로를 지정합니다. (예: C:\\Models\\Qwen2.5-Coder-7B-Instruct.gguf)"
        },
        "gitcat.safety.largeDeletionThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Safety Layer가 대량 삭제 경고를 발생시키는 삭제 파일 수 임계치입니다."
        },
        "gitcat.merge.openMainPanelOnConflict": {
          "type": "boolean",
          "default": true,
          "description": "Push/Pull/PR 가드 또는 병합 분석(CONFLICT_RESULT) 수신 시 GitCat 에디터 패널(메인 뷰)을 자동으로 엽니다. 사이드바와 동기화하려면 켜 두세요."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run typecheck && pnpm run compile",
    "compile": "node ./scripts/build-extension.cjs",
    "typecheck": "tsc --noEmit -p ./",
    "watch": "node ./scripts/build-extension.cjs --watch",
    "lint": "eslint src --ext ts",
    "package:vsix": "node ./scripts/package-vsix.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@gitcat/git-client-cli": "workspace:*",
    "@gitcat/git-core": "workspace:*",
    "@gitcat/shared-types": "workspace:*",
    "@gitcat/storage": "workspace:*",
    "@gitcat/ai-pipeline": "workspace:*"
  }
}
