{
  "name": "gitcat",
  "displayName": "GitCat",
  "description": "%extension.description%",
  "publisher": "GitCat",
  "icon": "media/GitCat_icon.png",
  "version": "0.0.5",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shsgrnd/s14-final_S14P31B103.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:gitcat-sidebar-webview",
    "onCommand:gitcat.openPanel",
    "onCommand:gitcat.createSnapshot",
    "onCommand:gitcat.getGitStatus",
    "onCommand:gitcat.installLocalRuntime",
    "onCommand:gitcat.setGitHubToken",
    "onCommand:gitcat.clearGitHubToken"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitcat.openPanel",
        "title": "%command.openPanel.title%"
      },
      {
        "command": "gitcat.getGitStatus",
        "title": "%command.getGitStatus.title%"
      },
      {
        "command": "gitcat.createSnapshot",
        "title": "%command.createSnapshot.title%"
      },
      {
        "command": "gitcat.installLocalRuntime",
        "title": "%command.installLocalRuntime.title%"
      },
      {
        "command": "gitcat.setGitHubToken",
        "title": "%command.setGitHubToken.title%"
      },
      {
        "command": "gitcat.clearGitHubToken",
        "title": "%command.clearGitHubToken.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitcat-sidebar",
          "title": "GitCat",
          "icon": "media/GitCat_icon.png"
        }
      ]
    },
    "views": {
      "gitcat-sidebar": [
        {
          "type": "webview",
          "id": "gitcat-sidebar-webview",
          "name": "GitCat",
          "icon": "media/GitCat_icon.png"
        }
      ]
    },
    "configuration": {
      "title": "GitCat",
      "properties": {
        "gitcat.branchCleanup.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.branchCleanup.enabled.description%"
        },
        "gitcat.branchCleanup.olderThanValue": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "%config.branchCleanup.olderThanValue.description%"
        },
        "gitcat.branchCleanup.olderThanUnit": {
          "type": "string",
          "enum": [
            "week",
            "month"
          ],
          "default": "month",
          "description": "%config.branchCleanup.olderThanUnit.description%"
        },
        "gitcat.branchCleanup.deleteMergedBranches": {
          "type": "boolean",
          "default": true,
          "description": "%config.branchCleanup.deleteMergedBranches.description%"
        },
        "gitcat.branchCleanup.deleteGoneRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "%config.branchCleanup.deleteGoneRemoteBranches.description%"
        },
        "gitcat.branchCleanup.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "develop",
            "dev",
            "release"
          ],
          "description": "%config.branchCleanup.protectedBranches.description%"
        },
        "gitcat.language": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "gitcat.ai.mode": {
          "type": "string",
          "enum": [
            "live-remote",
            "live-local"
          ],
          "default": "live-local",
          "description": "%config.ai.mode.description%"
        },
        "gitcat.ai.localModelPath": {
          "type": "string",
          "default": "",
          "description": "%config.ai.localModelPath.description%"
        },
        "gitcat.safety.largeDeletionThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "%config.safety.largeDeletionThreshold.description%"
        },
        "gitcat.merge.openMainPanelOnConflict": {
          "type": "boolean",
          "default": true,
          "description": "%config.merge.openMainPanelOnConflict.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run typecheck && pnpm run compile",
    "compile": "node ./scripts/build-extension.cjs",
    "typecheck": "tsc --noEmit -p ./",
    "watch": "node ./scripts/build-extension.cjs --watch",
    "lint": "eslint src --ext ts",
    "package:vsix": "node ./scripts/package-vsix.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@gitcat/git-client-cli": "workspace:*",
    "@gitcat/git-core": "workspace:*",
    "@gitcat/shared-types": "workspace:*",
    "@gitcat/storage": "workspace:*",
    "@gitcat/ai-pipeline": "workspace:*"
  }
}
