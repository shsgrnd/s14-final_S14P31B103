{
  "name": "gitcat",
  "displayName": "GitCat",
  "description": "An AI-powered Git assistant for safer commits, conflict prevention, and smarter workflow guidance in VS Code.",
  "publisher": "ssafy",
  "icon": "icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitcat.openPanel",
        "title": "GitCat: Open Panel"
      },
      {
        "command": "gitcat.getGitStatus",
        "title": "GitCat: Refresh Status"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitcat-sidebar",
          "title": "GitCat",
          "icon": "media/GitCat_icon.png"
        }
      ]
    },
    "views": {
      "gitcat-sidebar": [
        {
          "type": "webview",
          "id": "gitcat-sidebar-webview",
          "name": "GitCat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package:vsix": "node ./scripts/package-vsix.cjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 --version 35.2.0 --dist-url https://electronjs.org/headers/download"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "@electron/rebuild": "^3.7.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@gitcat/shared-types": "workspace:*",
    "@gitcat/storage": "workspace:*"
  }
}
