{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@gitcat/storage": ["../storage/src/index.ts"],
      "@gitcat/storage/*": ["../storage/src/*"],
      "@gitcat/shared-types": ["../shared-types/src/index.ts"],
      "@gitcat/shared-types/*": ["../shared-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
